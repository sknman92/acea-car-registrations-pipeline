{
  "mcpServers": {
    "tableau": {
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        ".vscode/start-tableau-mcp.ps1"
      ]
    },
    "dbt": {
      "command": "<PATH_TO_REPO>/.venv/Scripts/uvx.exe",
      "args": ["dbt-mcp"],
      "env": {
        "DBT_PROJECT_DIR": "<PATH_TO_REPO>/dbt",
        "DBT_PATH": "<PATH_TO_REPO>/.venv/Scripts/dbt.exe",
        "DISABLE_DBT_CODEGEN": "false"
      }
    }
  }
}
